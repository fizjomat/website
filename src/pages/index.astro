---
import Base from '../layouts/Base.astro';
import BookingButton from '../components/BookingButton.astro';
import { getCollection } from 'astro:content';

const uslugi = await getCollection('uslugi');
const uslugiSorted = uslugi.sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="FIZJOMAT – Fizjoterapia ortopedyczna Gliwice"
  description="Centrum profesjonalnej fizjoterapii i rehabilitacji ortopedycznej w Gliwicach. Umów wizytę online z Michałem Klapuchem lub Szymonem Mączko."
>

  <!-- GALERIA -->
  <section id="galeria" class="gallery-section">
    <div class="gallery-carousel" aria-label="Galeria FIZJOMAT">
      <div class="gallery-track" id="galleryTrack">
        <div class="gallery-slide">
          <img src="/images/foto1.jpg" alt="Gabinet fizjoterapii FIZJOMAT" width="1200" height="800" loading="eager" />
        </div>
        <div class="gallery-slide">
          <img src="/images/foto-2.jpg" alt="Fizjoterapia FIZJOMAT" width="1200" height="800" loading="lazy" />
        </div>
        <div class="gallery-slide">
          <img src="/images/poczekalnia.jpg" alt="Poczekalnia FIZJOMAT" width="1200" height="550" loading="lazy" />
        </div>
        <div class="gallery-slide">
          <img src="/images/poczekalnia-2.jpg" alt="Poczekalnia FIZJOMAT" width="1200" height="550" loading="lazy" />
        </div>
        <div class="gallery-slide">
          <img src="/images/IMG_4557JPEG-crop.jpeg" alt="Gabinet FIZJOMAT" width="1200" height="550" loading="lazy" />
        </div>
        <div class="gallery-slide">
          <img src="/images/IMG_4558JPEG-crop.jpeg" alt="Gabinet FIZJOMAT" width="1200" height="550" loading="lazy" />
        </div>
        <div class="gallery-slide">
          <img src="/images/IMG_4570JPEG-crop.jpeg" alt="Gabinet FIZJOMAT" width="1200" height="550" loading="lazy" />
        </div>
      </div>
      <div class="gallery-dots" id="galleryDots">
        <button class="dot active" aria-label="Zdjęcie 1"></button>
        <button class="dot" aria-label="Zdjęcie 2"></button>
        <button class="dot" aria-label="Zdjęcie 3"></button>
        <button class="dot" aria-label="Zdjęcie 4"></button>
        <button class="dot" aria-label="Zdjęcie 5"></button>
        <button class="dot" aria-label="Zdjęcie 6"></button>
        <button class="dot" aria-label="Zdjęcie 7"></button>
      </div>
    </div>
  </section>

  <!-- HERO -->
  <section class="hero" id="hero">
    <div class="container hero-inner">
      <p class="hero-eyebrow">FIZJOMAT</p>
      <h1>Odzyskaj sprawność</h1>
      <p class="hero-tagline">W <strong>FIZJOMAT</strong> pomagamy odzyskać pełną sprawność i cieszyć się życiem bez bólu. Nasz doświadczony zespół fizjoterapeutów oferuje indywidualne podejście i skuteczne terapie, dopasowane do Twoich potrzeb. Rozpocznij drogę do zdrowia już dziś!</p>
      <div class="hero-ctas">
        <BookingButton
          href="https://booksy.com/pl-pl/310393_fizjomat-michal-klapuch_fizjoterapia_12795_gliwice"
          label="Umów wizytę – Michał"
        />
        <BookingButton
          href="https://booksy.com/pl-pl/337615_szymon-maczko-fizjoterapia-i-trening_fizjoterapia_12795_gliwice"
          label="Umów wizytę – Szymon"
          variant="outline"
        />
      </div>
    </div>
  </section>

  <!-- O NAS -->
  <section id="o-nas">
    <div class="container">
      <h2>Kim jesteśmy?</h2>
      <p>FIZJOMAT to centrum profesjonalnej fizjoterapii i rehabilitacji ortopedycznej w Gliwicach. Specjalizujemy się w terapii bólu narządu ruchu, rehabilitacji sportowej i diagnostyce funkcjonalnej.</p>
      <p>Naszym celem jest przywrócenie pełnej sprawności pacjentom i poprawa jakości ich życia. Każdą terapię opieramy na dokładnej diagnozie i indywidualnym planie leczenia.</p>
    </div>
  </section>

  <!-- USŁUGI -->
  <section id="uslugi">
    <div class="container">
      <h2>Oferta</h2>
      <p class="section-lead">Specjalizujemy się w sześciu obszarach fizjoterapii i rehabilitacji.</p>
      <ul class="services-grid">
        {uslugiSorted.map((usluga) => (
          <li class="service-card">
            <a href={`/uslugi/${usluga.id}`} class="service-card-link">
              {usluga.data.image && (
                <div class="service-card-img">
                  <img src={usluga.data.image} alt={usluga.data.title} width="400" height="350" loading="lazy" />
                </div>
              )}
              <div class="service-card-body">
                <h3>{usluga.data.title}</h3>
                <p>{usluga.data.excerpt}</p>
                <span class="card-link">Dowiedz się więcej →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ZESPÓŁ -->
  <section id="zespol">
    <div class="container">
      <h2>Nasz zespół</h2>
      <div class="team-hero">
        <img src="/images/team-bg.webp" alt="Zespół FIZJOMAT" width="396" height="417" loading="lazy" />
      </div>
      <div class="team-grid">
        <div class="team-card">
          <div class="team-card-photo">
            <img src="/images/team-michal.webp" alt="Michał Klapuch" width="386" height="435" loading="lazy" />
          </div>
          <div class="team-card-body">
            <h3>Michał Klapuch</h3>
            <p>Magister fizjoterapii i wychowania fizycznego AWF Katowice. Specjalizuje się w terapii bólu narządu ruchu, rehabilitacji sportowej, kinezyterapii i terapii manualnej. Stosuje diagnostykę funkcjonalną i USG. Aktywny triathlonista.</p>
            <BookingButton
              href="https://booksy.com/pl-pl/310393_fizjomat-michal-klapuch_fizjoterapia_12795_gliwice"
              label="Umów wizytę"
            />
          </div>
        </div>
        <div class="team-card">
          <div class="team-card-photo">
            <img src="/images/team-szymon.webp" alt="Szymon Mączko" width="396" height="435" loading="lazy" />
          </div>
          <div class="team-card-body">
            <h3>Szymon Mączko</h3>
            <p>Absolwent fizjoterapii AWF Katowice. Pracuje z pacjentami z dysfunkcjami narządu ruchu i osobami chcącymi bezpiecznie uprawiać aktywność fizyczną. Stale poszerza wiedzę z zakresu diagnostyki funkcjonalnej i rehabilitacji ortopedycznej.</p>
            <BookingButton
              href="https://booksy.com/pl-pl/337615_szymon-maczko-fizjoterapia-i-trening_fizjoterapia_12795_gliwice"
              label="Umów wizytę"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ZDJĘCIA -->
  <section id="zdjecia" class="photos-section">
    <div class="photos-grid">
      <div class="photo-item">
        <img src="/images/bottom-1.webp" alt="Gabinet FIZJOMAT" width="400" height="300" loading="lazy" />
      </div>
      <div class="photo-item">
        <img src="/images/bottom-2.webp" alt="Gabinet FIZJOMAT" width="400" height="300" loading="lazy" />
      </div>
      <div class="photo-item">
        <img src="/images/bottom-3.webp" alt="Gabinet FIZJOMAT" width="400" height="300" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- KONTAKT -->
  <section id="kontakt">
    <div class="container kontakt-inner">
      <div class="kontakt-info">
        <h2>Skontaktuj się</h2>
        <address>
          <p><strong>Adres:</strong><br />ul. Sowińskiego 72<br />44-121 Gliwice</p>
          <p><strong>Telefon:</strong><br /><a href="tel:+48660681468">+48 660 681 468</a></p>
          <p><strong>E-mail:</strong><br /><a href="mailto:fizjomat@gmail.com">fizjomat@gmail.com</a></p>
        </address>
      </div>
      <div class="kontakt-form">
        <h2>Wyślij wiadomość</h2>
        <form action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="e5e5574e-7a1b-4cd1-88c9-e123d3cae509" />
          <input type="hidden" name="subject" value="Nowa wiadomość z fizjomat.com.pl" />
          <input type="hidden" name="redirect" value={`${import.meta.env.SITE}/?sent=1`} />
          <div class="form-group">
            <label for="name">Imię i nazwisko</label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>
          <div class="form-group">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
          <div class="form-group">
            <label for="message">Wiadomość</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Wyślij</button>
        </form>
      </div>
    </div>
  </section>

</Base>

<style>
  /* GALLERY */
  .gallery-section {
    padding: 0;
    background: var(--color-bg-alt);
  }
  .gallery-carousel {
    position: relative;
    overflow: hidden;
    height: 520px;
  }
  .gallery-track {
    display: flex;
    height: 100%;
    transition: transform 0.6s ease;
  }
  .gallery-slide {
    min-width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: var(--color-bg-alt);
  }
  .gallery-slide img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .gallery-dots {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--color-primary);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s;
  }
  .dot.active {
    background: var(--color-primary);
  }

  /* HERO */
  .hero {
    background: var(--color-bg);
    padding: 5rem 1.5rem;
    text-align: center;
  }
  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .hero-eyebrow {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .hero h1 { margin-bottom: 0; }
  .hero-tagline { font-size: 1.15rem; color: var(--color-text-muted); max-width: 600px; }
  .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 0.5rem; }

  /* SERVICES */
  .section-lead { color: var(--color-text-muted); margin-bottom: 2rem; }
  .services-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .service-card {
    overflow: hidden;
    border-radius: var(--radius);
    position: relative;
    background: var(--color-primary);
    height: 320px;
    border: none;
  }
  .service-card-link {
    display: block;
    height: 100%;
    position: relative;
    text-decoration: none;
  }
  .service-card-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .service-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .service-card:hover .service-card-img img { transform: scale(1.08); }
  .service-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(18,38,65,0.9) 30%, rgba(18,38,65,0.2) 100%);
    pointer-events: none;
    z-index: 1;
  }
  .service-card-body {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 1.5rem;
    z-index: 2;
  }
  .service-card-body h3 { color: #fff; margin-bottom: 0.4rem; }
  .service-card-body p { color: rgba(255,255,255,0.8); font-size: 0.88rem; margin-bottom: 0.5rem; }
  .card-link { font-weight: 600; font-size: 0.85rem; color: #89c4ff; }

  /* TEAM */
  .team-hero {
    margin-bottom: 2rem;
    border-radius: var(--radius);
    overflow: hidden;
    max-height: 420px;
  }
  .team-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  .team-card {
    background: #fff;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .team-card-photo {
    width: 100%;
    aspect-ratio: 4/5;
    overflow: hidden;
  }
  .team-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .team-card:hover .team-card-photo img { transform: scale(1.04); }
  .team-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  /* BOTTOM PHOTOS */
  .photos-section { padding: 0; }
  .photos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .photo-item {
    overflow: hidden;
    aspect-ratio: 4/3;
  }
  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }
  .photo-item:hover img { transform: scale(1.08); }
  @media (max-width: 640px) {
    .photos-grid { grid-template-columns: 1fr; }
    .photo-item { aspect-ratio: 16/9; }
  }

  /* KONTAKT */
  .kontakt-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 3rem;
  }
  .kontakt-info address { font-style: normal; display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1rem; }
  .form-group label { font-weight: 500; font-size: 0.9rem; }
  .form-group input,
  .form-group textarea {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.6rem 0.85rem;
    font-size: 1rem;
    font-family: var(--font-sans);
    background: var(--color-bg);
    color: var(--color-text);
    width: 100%;
  }
  .form-group input:focus,
  .form-group textarea:focus {
    outline: 2px solid var(--color-accent);
    border-color: var(--color-accent);
  }

</style>

<script>
  const track = document.getElementById('galleryTrack') as HTMLElement;
  const dots = document.querySelectorAll('.dot');
  const total = dots.length;
  let current = 0;

  function goTo(index: number) {
    current = index;
    track.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  }

  dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

  setInterval(() => goTo((current + 1) % total), 4000);
</script>

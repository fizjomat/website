---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BookingButton from '../../components/BookingButton.astro';

export async function getStaticPaths() {
  const uslugi = await getCollection('uslugi');
  return uslugi.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={`${entry.data.title} – FIZJOMAT Gliwice`} description={entry.data.description}>
  <article class="service-page">
    <div class="container">
      <nav class="breadcrumb" aria-label="Nawigacja okruszkowa">
        <a href="/">Strona główna</a>
        <span aria-hidden="true">›</span>
        <a href="/#uslugi">Usługi</a>
        <span aria-hidden="true">›</span>
        <span>{entry.data.title}</span>
      </nav>

      <div class={`service-layout${entry.data.image ? ' has-photo' : ''}`}>
        <div class="service-content">
          <h1>{entry.data.title}</h1>
          <div class="prose">
            <Content />
          </div>
          <div class="service-cta">
            <BookingButton
              href="https://booksy.com/pl-pl/310393_fizjomat-michal-klapuch_fizjoterapia_12795_gliwice"
              label="Umów wizytę – Michał"
            />
            <BookingButton
              href="https://booksy.com/pl-pl/337615_szymon-maczko-fizjoterapia-i-trening_fizjoterapia_12795_gliwice"
              label="Umów wizytę – Szymon"
              variant="outline"
            />
          </div>
          <a href="/#uslugi" class="btn btn-outline back-link">← Wszystkie usługi</a>
        </div>

        {entry.data.image && (
          <div class="service-photo-wrap">
            <img
              class="service-parallax-img"
              id="serviceParallaxImg"
              src={entry.data.image}
              alt={entry.data.title}
              width="560"
              height="600"
              loading="eager"
            />
          </div>
        )}
      </div>
    </div>
  </article>
</Base>

<style>
  .service-page { padding: var(--section-padding); }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .breadcrumb a { color: var(--color-text-muted); }
  .breadcrumb a:hover { color: var(--color-primary); }

  /* Two-column layout */
  .service-layout.has-photo {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 4rem;
    align-items: start;
  }

  /* Content column */
  .service-content h1 { margin-bottom: 1.5rem; }
  .prose { max-width: 65ch; }
  .prose p { margin-bottom: 1rem; }
  .prose ul { margin: 0.5rem 0 1rem 1.25rem; }
  .prose li { margin-bottom: 0.35rem; }
  .prose strong { color: var(--color-primary); }
  .back-link { margin-top: 2rem; display: inline-block; }
  .service-cta { display: flex; gap: 1rem; flex-wrap: wrap; margin: 2rem 0 0.5rem; }

  /* Photo column — sticky with parallax */
  .service-photo-wrap {
    position: sticky;
    top: 100px;
    overflow: hidden;
    border-radius: var(--radius);
    height: 520px;
    box-shadow: 0 8px 32px rgba(30, 58, 95, 0.15);
  }
  .service-parallax-img {
    width: 100%;
    height: 140%;
    object-fit: cover;
    object-position: center top;
    display: block;
    will-change: transform;
  }

  /* Mobile: single column, photo on top */
  @media (max-width: 800px) {
    .service-layout.has-photo {
      grid-template-columns: 1fr;
    }
    .service-photo-wrap {
      position: static;
      height: 280px;
      order: -1;
      box-shadow: none;
    }
    .service-parallax-img {
      height: 100%;
    }
  }
</style>

<script>
  const wrap = document.querySelector('.service-photo-wrap') as HTMLElement | null;
  const img = document.getElementById('serviceParallaxImg') as HTMLImageElement | null;
  if (wrap && img && window.innerWidth > 800) {
    const onScroll = () => {
      const rect = wrap.getBoundingClientRect();
      const center = rect.top + rect.height / 2 - window.innerHeight / 2;
      img.style.transform = `translateY(${center * 0.18}px)`;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

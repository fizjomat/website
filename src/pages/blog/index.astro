---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---
<Base title="Blog – FIZJOMAT" description="Artykuły o fizjoterapii, rehabilitacji i zdrowym stylu życia od zespołu FIZJOMAT w Gliwicach.">
  <section class="blog-listing">
    <div class="container">
      <h1>Blog</h1>
      <p class="section-lead">Wiedza o fizjoterapii, rehabilitacji i aktywnym stylu życia.</p>
      {posts.length === 0 ? (
        <p>Brak wpisów. Wkrótce pojawią się pierwsze artykuły.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-card">
              <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <span>·</span>
                <span>{post.data.author}</span>
              </div>
              <p>{post.data.excerpt}</p>
              <a href={`/blog/${post.id}`} class="read-more">Czytaj dalej →</a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>

<style>
  .blog-listing { padding: var(--section-padding); }
  .section-lead { color: var(--color-text-muted); margin-bottom: 2rem; }
  .post-list { list-style: none; display: flex; flex-direction: column; gap: 2rem; }
  .post-card { border-bottom: 1px solid var(--color-border); padding-bottom: 2rem; }
  .post-card h2 { font-size: 1.5rem; margin-bottom: 0.5rem; }
  .post-card h2 a { color: var(--color-primary); }
  .post-card h2 a:hover { text-decoration: underline; }
  .post-meta { display: flex; gap: 0.5rem; color: var(--color-text-muted); font-size: 0.85rem; margin-bottom: 0.75rem; }
  .post-card p { color: var(--color-text-muted); margin-bottom: 0.75rem; }
  .read-more { font-weight: 600; font-size: 0.9rem; color: var(--color-accent); }
</style>

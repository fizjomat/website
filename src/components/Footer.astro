    <div class="footer-contact">
      <h3>Kontakt</h3>
      <address>
        <p>ul. Sowińskiego 72<br />44-121 Gliwice</p>
        <p><a href="tel:+48660681468">+48 660 681 468</a></p>
        <p><a href="mailto:fizjomat@gmail.com">fizjomat@gmail.com</a></p>
      </address>
    </div>
    <div class="footer-nav">
      <h3>Menu</h3>
      <ul>
        <li><a href="/#o-nas">O nas</a></li>
        <li><a href="/#uslugi">Usługi</a></li>

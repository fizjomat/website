<style>
  .site-footer {
    background: var(--color-primary);
    color: #e8edf4;
    padding: 3rem 0 0;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    padding-bottom: 2rem;
  }
  .footer-brand p { color: #c5d0de; font-size: 0.9rem; margin-top: 0.75rem; }
  .footer-contact h3, .footer-nav h3 {
    color: #fff;
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }
  .footer-contact address { font-style: normal; }
  .footer-contact a, .footer-nav a { color: #c5d0de; }
  .footer-contact a:hover, .footer-nav a:hover { color: #fff; }
  .footer-nav ul { list-style: none; }
  .footer-nav li { margin-bottom: 0.4rem; }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.15);
    text-align: center;
    padding: 1rem;
    font-size: 0.85rem;
    color: #8a9bb0;
  }
</style>

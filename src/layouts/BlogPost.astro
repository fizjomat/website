---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  author: string;
  tags: string[];
}

const { title, description, date, author, tags } = Astro.props;
const formattedDate = date.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={`${title} – Blog FIZJOMAT`} description={description} ogType="article">
  <article class="blog-post">
    <div class="container">
      <nav class="breadcrumb" aria-label="Nawigacja okruszkowa">
        <a href="/">Strona główna</a>
        <span aria-hidden="true">›</span>
        <a href="/blog">Blog</a>
        <span aria-hidden="true">›</span>
        <span>{title}</span>
      </nav>
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          <span>·</span>
          <span>{author}</span>
          {tags.length > 0 && (
            <ul class="tag-list" aria-label="Tagi">
              {tags.map(tag => <li class="tag">{tag}</li>)}
            </ul>
          )}
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
      <a href="/blog" class="btn btn-outline back-link">← Wszystkie wpisy</a>
    </div>
  </article>
</Base>

<style>
  .blog-post { padding: var(--section-padding); }
  .breadcrumb { display: flex; gap: 0.5rem; align-items: center; font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 1.5rem; flex-wrap: wrap; }
  .breadcrumb a { color: var(--color-text-muted); }
  .breadcrumb a:hover { color: var(--color-primary); }
  .post-header { margin-bottom: 2rem; }
  .post-meta { display: flex; gap: 0.5rem; align-items: center; color: var(--color-text-muted); font-size: 0.9rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .tag-list { list-style: none; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tag { background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: 999px; padding: 0.15rem 0.6rem; font-size: 0.8rem; }
  .prose { max-width: 70ch; }
  .prose p { margin-bottom: 1rem; }
  .prose h2 { margin-top: 2rem; margin-bottom: 0.75rem; }
  .prose h3 { margin-top: 1.5rem; margin-bottom: 0.5rem; }
  .back-link { margin-top: 2rem; display: inline-block; }
</style>
